{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "organizer", "targets", "actions", "source_url", "last_verified"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 90 },
    "title": { "$ref": "#/definitions/text" },
    "organizer": { "$ref": "#/definitions/text" },
    "targets": { "$ref": "#/definitions/tags" },
    "actions": { "$ref": "#/definitions/tags" },
    "source_url": { "$ref": "#/definitions/url" },
    "source_label": { "$ref": "#/definitions/text" },
    "last_verified": { "type": "string", "format": "date" },
    "opens_on": { "type": "string", "format": "date" },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "time_zone"],
      "oneOf": [{ "required": ["at"] }, { "required": ["day"] }],
      "properties": {
        "label": { "$ref": "#/definitions/text" },
        "time_zone": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
        "day": { "type": "string", "format": "date" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "$ref": "#/definitions/text" },
        "url": { "$ref": "#/definitions/url" }
      }
    },
    "solutions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url", "description"],
        "properties": {
          "label": { "$ref": "#/definitions/text" },
          "url": { "$ref": "#/definitions/url" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  },
  "dependencies": { "opens_on": ["deadline"] },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "maxLength": 160 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/text" }
    },
    "url": { "type": "string", "format": "uri", "pattern": "^https://[^/]+" }
  }
}
